<Window x:Class="MobaSkillBar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MobaSkillBar"
        Title="MOBA 技能栏" Width="450" Height="630" MinWidth="415" MinHeight="555"
        Background="#111B25" Foreground="#EAF2F8" FontFamily="Segoe UI, Microsoft YaHei UI"
        FontSize="14" UseLayoutRounding="True">
    <Window.Resources>
        <local:PercentValueConverter x:Key="PercentValue" />
        <Style TargetType="Button">
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="PercentageField" TargetType="TextBox">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <Setter Property="Padding" Value="3,1" />
            <Setter Property="Margin" Value="5,0" />
            <Setter Property="Text" Value="{Binding Tag.Value, RelativeSource={RelativeSource Self}, Mode=TwoWay,
                    UpdateSourceTrigger=Explicit, Converter={StaticResource PercentValue}}" />
            <EventSetter Event="PreviewMouseDoubleClick" Handler="SelectPercentage" />
            <EventSetter Event="PreviewKeyDown" Handler="PercentageKeyDown" />
            <EventSetter Event="LostKeyboardFocus" Handler="CommitPercentage" />
        </Style>
        <Style x:Key="ResetButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Content" Value="复位" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="24" />
            <EventSetter Event="Click" Handler="ResetSetting" />
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <TextBlock Text="MOBA 技能栏" FontSize="25" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" Margin="0,10,0,6">
                <Button x:Name="ModeButton" Click="ToggleMode" />
                <Button x:Name="BarVisibilityButton" Click="ToggleBarVisibility" />
            </StackPanel>
            <TextBlock x:Name="ModeHint" Foreground="#BCC9D5" />
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,16,0,0">
            <TextBlock Text="布局" FontWeight="SemiBold" />
            <DockPanel Margin="0,6,0,0" LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="7,0,-6,0">
                    <Button Content="新建" Click="CreateLayout" />
                    <Button Content="重命名" Click="RenameLayout" />
                    <Button Content="删除" Click="DeleteLayout" />
                </StackPanel>
                <ComboBox x:Name="PresetBox" AutomationProperties.Name="布局" DisplayMemberPath="Name"
                          VerticalContentAlignment="Center" SelectionChanged="SwitchLayout" />
            </DockPanel>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,16,0,6">
            <Button Content="框选技能格" Click="AddTile" />
            <Button x:Name="ReplaceButton" Content="重新框选" Click="ReplaceTile" />
            <Button x:Name="RenameTileButton" Content="重命名" Click="RenameTile" />
            <Button x:Name="RemoveButton" Content="移除技能格" Click="RemoveTile" />
        </StackPanel>
        <ListBox x:Name="TileList" Grid.Row="3" SelectionMode="Extended" MinHeight="65"
                 HorizontalContentAlignment="Stretch" AutomationProperties.Name="技能格" SelectionChanged="SelectTile">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding PositionText}" Margin="10,0,2,0"
                                   ToolTip="相对技能栏内容区左上角的物理像素坐标" />
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel x:Name="Appearance" Grid.Row="4" Margin="0,12,0,0">
            <TextBlock x:Name="SourceSummary" Foreground="#BCC9D5" Margin="0,0,0,7" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="78" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="32" />
                    <RowDefinition Height="32" />
                    <RowDefinition Height="32" />
                    <RowDefinition Height="32" />
                </Grid.RowDefinitions>
                <Label Grid.Row="0" Target="{Binding ElementName=ScaleSlider}" Content="缩放" Foreground="White" Padding="0" />
                <Slider x:Name="ScaleSlider" Grid.Row="0" Grid.Column="1" Minimum="0.25" Maximum="4" Value="1"
                        SmallChange="0.05" LargeChange="0.25" ValueChanged="ChangeAppearance" />
                <TextBox Grid.Row="0" Grid.Column="2" Style="{StaticResource PercentageField}" AutomationProperties.Name="缩放百分比"
                         Tag="{Binding ElementName=ScaleSlider}" />
                <Button Grid.Row="0" Grid.Column="3" Style="{StaticResource ResetButtonStyle}" AutomationProperties.Name="复位缩放"
                        Tag="{Binding ElementName=ScaleSlider}" />
                <Label Grid.Row="1" Target="{Binding ElementName=OpacitySlider}" Content="透明度" Foreground="White" Padding="0" />
                <Slider x:Name="OpacitySlider" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="1" Value="0"
                        SmallChange="0.05" LargeChange="0.1" ValueChanged="ChangeAppearance" />
                <TextBox Grid.Row="1" Grid.Column="2" Style="{StaticResource PercentageField}" AutomationProperties.Name="透明度百分比"
                         Tag="{Binding ElementName=OpacitySlider}" />
                <Button Grid.Row="1" Grid.Column="3" Style="{StaticResource ResetButtonStyle}" AutomationProperties.Name="复位透明度"
                        Tag="{Binding ElementName=OpacitySlider}" />
                <Label Grid.Row="2" Target="{Binding ElementName=ContrastSlider}" Content="对比度" Foreground="White" Padding="0" />
                <Slider x:Name="ContrastSlider" Grid.Row="2" Grid.Column="1" Minimum="0.25" Maximum="3" Value="1"
                        SmallChange="0.05" LargeChange="0.25" ValueChanged="ChangeAppearance" />
                <TextBox Grid.Row="2" Grid.Column="2" Style="{StaticResource PercentageField}" AutomationProperties.Name="对比度百分比"
                         Tag="{Binding ElementName=ContrastSlider}" />
                <Button Grid.Row="2" Grid.Column="3" Style="{StaticResource ResetButtonStyle}" AutomationProperties.Name="复位对比度"
                        Tag="{Binding ElementName=ContrastSlider}" />
                <Label Grid.Row="3" Target="{Binding ElementName=SaturationSlider}" Content="色度" Foreground="White" Padding="0" />
                <Slider x:Name="SaturationSlider" Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="2" Value="1"
                        SmallChange="0.05" LargeChange="0.25" ValueChanged="ChangeAppearance" />
                <TextBox Grid.Row="3" Grid.Column="2" Style="{StaticResource PercentageField}" AutomationProperties.Name="色度百分比"
                         Tag="{Binding ElementName=SaturationSlider}" />
                <Button Grid.Row="3" Grid.Column="3" Style="{StaticResource ResetButtonStyle}" AutomationProperties.Name="复位色度"
                        Tag="{Binding ElementName=SaturationSlider}" />
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Button x:Name="LowerButton" Content="向后叠放" Click="LowerTile" />
                <Button x:Name="RaiseButton" Content="向前叠放" Click="RaiseTile" />
            </StackPanel>
        </StackPanel>
        <TextBlock x:Name="Notice" Grid.Row="5" Margin="0,10,0,0" Foreground="#FFD096" Visibility="Collapsed" />
    </Grid>
</Window>
